$major-release = '25'
$fonts-root = '/documentation/' + $major-release + '/assets/fonts'
$open-sans-name = 'Open Sans'
$source-code-pro-name = 'Source Code Pro'
$image-padding = 2em

/// Import OpenSans Regular
@font-face
  font-family $open-sans-name
  src url($fonts-root + '/opensans/OpenSans-Regular-webfont.woff') format('woff')
  font-weight normal
  font-style normal

/// Import OpenSans Semibold
@font-face
  font-family $open-sans-name
  src url($fonts-root + '/opensans/OpenSans-Semibold-webfont.woff') format('woff')
  font-weight 600
  font-style normal

/// Import Source Code Pro Regular
@font-face
  font-family $source-code-pro-name
  font-style normal
  font-weight normal
  src url($fonts-root + '/sourcecodepro/source-code-pro-regular.woff2') format('woff2'),
      url($fonts-root + '/sourcecodepro/source-code-pro-regular.woff') format('woff')

body
  font-family $open-sans-name, sans-serif

code, kbd, .line-number
  font-family $source-code-pro-name, monospace

a
  font-weight 600

aside.sidebar
  .search-box
    width 13.2rem
    margin 0
    margin-top 1.5rem
    padding 0
    margin-left 1.25rem
    input
      padding-left 2rem
      padding-right 0.5rem
      width "calc(100% - %s - %s)" % (@padding-left @padding-right)
    ul.suggestions
      right auto !important;
      left 0 !important;
      width 100%;
      z-index 1;
    @media (max-width: $MQNarrow)
      input
        cursor text
        border-color darken($borderColor, 10%)
        &:focus
          border-color $accentColor
      ul.suggestions
        width 210px;
    @media (max-width: $MQMobile)
      input
        left 0
  .search-box + .sidebar-links
    padding-top: 1rem

.toggle-sidebar-button
  display none
  cursor pointer
  // Put the button above code blocks and below sidebar
  z-index 8
  width 1.25rem
  height 1.25rem
  position fixed
  padding 0.6rem
  top 0.6rem
  left 0.6rem
  border: 1px solid #eee;
  background: white;
  box-shadow: 0px 0px 10px #eee;
  @media (max-width: $MQMobile)
    display block
  .icon
    display block
    width 1.25rem
    height 1.25rem

img
  display block
  margin-top $image-padding
  margin-bottom $image-padding
  margin-left auto
  margin-right auto

img[alt^="screen-"]
  border 1px solid #ddd


// Mermaid.js support

.mermaid-diagram
  margin-top $image-padding
  margin-bottom $image-padding
  text-align center

.mermaid-error
  text-align center
  // color $badgeErrorColor
  color #555
  font-style italic
  background-color #eee
  padding $image-padding
  margin $image-padding
  p
    margin-top: 0.15em
    margin-bottom: 0
  a
    font-weight normal


// Loader based on https://tobiasahlin.com/spinkit/

.spinner
  width 40px
  height 40px
  margin auto auto
  animation sk-rotateplane 1.2s infinite ease-in-out
  background-color $accentColor

@keyframes sk-rotateplane
  0%
    transform perspective(120px) rotateX(0deg) rotateY(0deg)
  50%
    transform perspective(120px) rotateX(-180.1deg) rotateY(0deg)
  100%
    transform perspective(120px) rotateX(-180deg) rotateY(-179.9deg)


// Elements added by Homepage integration - should be not visible
// until Homepage integration styles are loaded.
.onedata-homepage-element
  display none

img.intro-header
  margin-left 0
  margin-bottom 0
